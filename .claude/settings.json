{
  "$comment": "Example allowlist for an agent-driven PHP project. It exists to keep the loop moving without permission prompts on read-only and build commands, while every destructive or network-mutating action still requires a human. Trim it to what your project actually uses.",
  "permissions": {
    "allow": [
      "Bash(make lint)",
      "Bash(make psalm)",
      "Bash(make psalm-diff)",
      "Bash(make rector)",
      "Bash(make rector-fix)",
      "Bash(make deptrac)",
      "Bash(make test-unit)",
      "Bash(make test-integration)",
      "Bash(make fix-all)",
      "Bash(make check)",

      "Bash(vendor/bin/psalm *)",
      "Bash(vendor/bin/phpunit *)",
      "Bash(vendor/bin/rector *)",
      "Bash(vendor/bin/deptrac *)",
      "Bash(vendor/bin/php-cs-fixer *)",
      "Bash(composer install)",
      "Bash(composer dump-autoload *)",
      "Bash(composer validate *)",
      "Bash(composer audit)",
      "Bash(php bin/console *)",

      "Edit(backend/src/**)",
      "Write(backend/src/**)",
      "Edit(backend/tests/**)",
      "Write(backend/tests/**)",
      "Edit(backend/migrations/**)",
      "Write(backend/migrations/**)",
      "Edit(adr/**)",
      "Write(adr/**)",
      "Edit(spec-driven/**)",
      "Edit(spec-driven-completed/**)",
      "Edit(QA/**)",
      "Write(QA/**)",

      "Bash(git status)",
      "Bash(git status *)",
      "Bash(git diff *)",
      "Bash(git log *)",
      "Bash(git show *)",
      "Bash(git branch *)",
      "Bash(git checkout *)",
      "Bash(git add *)",
      "Bash(git commit *)",
      "Bash(git push *)",
      "Bash(git pull *)",
      "Bash(git fetch *)",
      "Bash(git mv *)",
      "Bash(git rev-parse *)",

      "Bash(gh pr list *)",
      "Bash(gh pr view *)",
      "Bash(gh pr create *)",
      "Bash(gh pr checks *)",
      "Bash(gh auth status)",

      "Bash(ls *)",
      "Bash(cat *)",
      "Bash(grep *)",
      "Bash(rg *)",
      "Bash(find *)",
      "Bash(head *)",
      "Bash(tail *)",
      "Bash(wc *)",
      "Bash(which *)",
      "Bash(pwd)"
    ],
    "deny": [
      "Bash(sudo *)",
      "Bash(git push --force *)",
      "Bash(git reset --hard *)",
      "Bash(git clean *)",
      "Bash(git stash *)",
      "Bash(rm -rf *)",
      "Bash(gh pr merge *)",
      "Read(backend/.env)",
      "Read(**/.env)",
      "Edit(**/.env)",
      "Write(**/.env)"
    ]
  }
}
